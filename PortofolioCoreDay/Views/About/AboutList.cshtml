@model List<About>
@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<h2>Hakkımda Bilgileri</h2>

<table class="table table-borded">
    <tr>
        <th>#</th>
        <th>Açıklama</th>
        <th>Unvan</th>        
        <th>Doğum Tarihi</th>
        <th>Web Site</th>
        <th>Lisans</th>
        <th>Telefon</th>
        <th>Eposta</th>    
      
        <th>Güncelle</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AboutId</td>
            <td>@item.Description</td>
            <td>@item.Title</td>
            <td>@item.Birthday</td>
            <td>@item.Website</td>
            <td>@item.Degree</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>

            <td><a href="/About/UpdateAbout/@item.AboutId" class="btn btn-success">Güncelle</a></td>
        </tr>
    }

</table>
