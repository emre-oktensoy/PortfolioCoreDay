
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h1>İstatistikler</h1>

<div class="alert alert-primary">Toplam Yetenek Sayısı: @ViewBag.v1</div>
