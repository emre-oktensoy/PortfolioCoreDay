
<section id="stats" class="stats section">

	<div class="container" data-aos="fade-up" data-aos-delay="100">

		<div class="row gy-4">

			<div class="col-lg-3 col-md-6">
				<div class="stats-item">
					<i class="bi bi-emoji-smile"></i>
					<span data-purecounter-start="0" data-purecounter-end="@ViewBag.v1" data-purecounter-duration="1" class="purecounter"></span>
					<p><strong>Yeteneklerim</strong></p>
				</div>
			</div><!-- End Stats Item -->

			<div class="col-lg-3 col-md-6">
				<div class="stats-item">
					<i class="bi bi-journal-richtext"></i>
					<span data-purecounter-start="0" data-purecounter-end="@ViewBag.v2" data-purecounter-duration="1" class="purecounter"></span>
					<p><strong>Proje Sayısı</strong></p>
				</div>
			</div><!-- End Stats Item -->

			<div class="col-lg-3 col-md-6">
				<div class="stats-item">
					<i class="bi bi-headset"></i>
					<span data-purecounter-start="0" data-purecounter-end="@ViewBag.v3" data-purecounter-duration="1" class="purecounter"></span>
					<p><strong>Gelen Mesaj Sayısı</strong></p>
				</div>
			</div><!-- End Stats Item -->

			<div class="col-lg-3 col-md-6">
				<div class="stats-item">
					<i class="bi bi-people"></i>
					<span data-purecounter-start="0" data-purecounter-end="@{var random = new Random();var sayi = random.Next(10, 31);}@sayi" data-purecounter-duration="1" class="purecounter">
					</span>
					<p><strong>Random Number</strong> </p>
				</div>
			</div><!-- End Stats Item -->

		</div>

	</div>

</section>